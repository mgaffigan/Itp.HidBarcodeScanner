<Window x:Class="Itp.WpfCamera.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Itp.WpfCamera"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance IsDesignTimeCreatable=False, Type={x:Type local:CaptureWindowViewModel}}"
        Title="Capture Image" Background="Black"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Resources rather than static fields, so they stay out of the public API. -->
        <RoutedCommand x:Key="CaptureCommand" />
        <RoutedCommand x:Key="SwitchCameraCommand" />

        <Style x:Key="CaptureButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Transparent, not null, so the gap between ring and disc is still clickable. -->
                        <Grid Width="76" Height="76" Background="Transparent">
                            <Ellipse Stroke="#60000000" StrokeThickness="1" />
                            <Ellipse Margin="1" Stroke="White" StrokeThickness="4" />
                            <Ellipse x:Name="disc" Margin="9" Fill="White" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="disc" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="disc" Property="Margin" Value="12" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="48" Height="48">
                            <Ellipse x:Name="background" Fill="#80000000" Stroke="#60FFFFFF" StrokeThickness="1" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="background" Property="Fill" Value="#B0000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="{StaticResource CaptureCommand}" Executed="Capture_Executed" />
        <CommandBinding Command="{StaticResource SwitchCameraCommand}" Executed="SwitchCamera_Executed" CanExecute="SwitchCamera_CanExecute" />
        <CommandBinding Command="ApplicationCommands.Close" Executed="Close_Executed" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="F2" Command="{StaticResource CaptureCommand}" />
        <KeyBinding Key="Escape" Command="ApplicationCommands.Close" />
    </Window.InputBindings>

    <!-- The preview is a D3DImage, so WPF content composes over it without airspace issues. -->
    <Grid>
        <Image Source="{Binding Path=Preview}" Stretch="Uniform" />

        <Grid HorizontalAlignment="Right" Margin="0,0,32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="1" Style="{StaticResource CaptureButtonStyle}"
                    Command="{StaticResource CaptureCommand}"
                    ToolTip="Capture (F2)" AutomationProperties.Name="Capture" />

            <!-- Hidden from code-behind when there is only one camera. -->
            <Button x:Name="btCamera" Grid.Row="2" VerticalAlignment="Top" Margin="0,24,0,0"
                    Style="{StaticResource OverlayButtonStyle}" Content="&#xE89E;"
                    ToolTip="{Binding Path=Group.DisplayName}" ToolTipService.InitialShowDelay="250"
                    AutomationProperties.Name="Switch camera" Click="btCamera_Click">
                <Button.ContextMenu>
                    <ContextMenu Placement="Left">
                        <ContextMenu.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding Path=DisplayName}" />
                                <Setter Property="Command" Value="{StaticResource SwitchCameraCommand}" />
                                <Setter Property="CommandParameter" Value="{Binding}" />
                                <!-- The menu is its own focus scope; route the command back to the window. -->
                                <Setter Property="CommandTarget"
                                        Value="{Binding Path=PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </Style>
                        </ContextMenu.ItemContainerStyle>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>
    </Grid>
</Window>

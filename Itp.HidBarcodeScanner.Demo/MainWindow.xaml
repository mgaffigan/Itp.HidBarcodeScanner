<Window x:Class="Itp.HidBarcodeScanner.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Itp.HidBarcodeScanner.Demo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
            <CheckBox x:Name="cbEnable" Content="Enable Scanner" Checked="cbEnable_Checked" Unchecked="cbEnable_Unchecked" IsChecked="True" VerticalAlignment="Center" />
            <CheckBox x:Name="cbDelay" Content="Delay" VerticalAlignment="Center" Margin="5,0,0,0" />
            <Button x:Name="btImageSnap" Content="_Snap Image" Width="75" Height="23" Margin="5,0,0,0" Click="btImageSnap_Click" />
        </StackPanel>
        <TextBox x:Name="tb" AcceptsReturn="True" />
    </DockPanel>
</Window>
